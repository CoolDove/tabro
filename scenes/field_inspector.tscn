[gd_scene load_steps=2 format=3 uid="uid://dl33f2qmifdj6"]

[sub_resource type="GDScript" id="GDScript_2yeqr"]
resource_name = "FieldInspector"
script/source = "extends Control
class_name FieldInspector

var field_name :String:
	get:
		return lb_field_name.text
	set(v):
		lb_field_name.text = v

var field_type :Main.FieldType:
	set(v):
		field_type = v
		optbtn_field_type.select(v)
		_on_select_field_type(field_type)

@onready var lb_field_name :Label= %FieldName
@onready var optbtn_field_type :OptionButton= %FieldType_OptionBtn
@onready var tabc_field_settings :TabContainer= %FieldSettings
@onready var footer = %Footer

signal on_field_type_changed(type: Main.FieldType)

func _ready():
	for k in Main.FieldType.keys():
		optbtn_field_type.add_item(k, Main.FieldType[k])
	optbtn_field_type.item_selected.connect(_on_select_field_type)

func _on_select_field_type(idx: int):
	_set_option_type(idx)

func _set_option_type(idx: int):
	on_field_type_changed.emit(idx)
	tabc_field_settings.current_tab = idx
	print(\"set option: %s\" % idx)
"

