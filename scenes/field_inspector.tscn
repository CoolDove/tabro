[sub_resource type="GDScript" id="GDScript_2yeqr"]
resource_name = "FieldInspector"
script/source = "extends Control
class_name FieldInspector

# Must set this before you use.
var fieldinfo : FieldData

var field_name :String:
	get:
		return lb_field_name.text
	set(v):
		lb_field_name.text = v

var field_type :Main.FieldType:
	set(v):
		field_type = v
		optbtn_field_type.select(v)
		_on_select_field_type(field_type)

@onready var lb_field_name :Label= %FieldName
@onready var optbtn_field_type :OptionButton= %FieldType_OptionBtn
@onready var tabc_field_settings :TabContainer= %FieldSettings
@onready var footer = %Footer

@onready var option_type_options_list :VBoxContainer= %OptionsList
@onready var option_type_btn_add_new_option :Button= %BtnAddNewOption

@onready var code_type_code_editor :TextEdit= %CodeEditor

signal on_field_type_changed(type: Main.FieldType)

func _ready():
	for k in Main.FieldType.keys():
		optbtn_field_type.add_item(k, Main.FieldType[k])
	optbtn_field_type.item_selected.connect(_on_select_field_type)
	tabc_field_settings.tab_changed.connect(_on_tab_open)

	option_type_btn_add_new_option.button_up.connect(func():
		var option_index = fieldinfo.toption_options.size()
		fieldinfo.toption_options.append(\"Option%s\" % option_index)
		_option_type_append_option_editor(option_index)
	)
	code_type_code_editor.text_changed.connect(func():
		fieldinfo.tcode_code = code_type_code_editor.text
	)

func _on_tab_open(tab_index: int):
	print(\"tab open: %s\" % tab_index)
	var tabname = tabc_field_settings.get_child(tab_index).name
	match tabname:
		\"OPTION\":
			_init_panel_option()
		\"CODE\":
			code_type_code_editor.text = fieldinfo.tcode_code
		_:
			print(\"Fallback tab open\")

func _on_select_field_type(idx: int):
	_set_option_type(idx)

func _set_option_type(idx: int):
	on_field_type_changed.emit(idx)
	if tabc_field_settings.current_tab != idx:
		tabc_field_settings.current_tab = idx
	else:
		tabc_field_settings.tab_changed.emit(idx) # Manually emit the signal to refresh panel.
	print(\"set option: %s\" % idx)

func _init_panel_option():
	for c in option_type_options_list.get_children(): c.queue_free()
	for option_index in range(0, fieldinfo.toption_options.size()):
		_option_type_append_option_editor(option_index)

func _option_type_append_option_editor(option_index: int):
	var box = HBoxContainer.new()
	box.set_meta(\"option_idx\", option_index)
	box.custom_minimum_size.y = 32
	box.size_flags_horizontal = Control.SIZE_EXPAND_FILL

	var option_editor = LineEdit.new()
	option_editor.set_meta(\"option_idx\", option_index)
	option_editor.custom_minimum_size.y = 32
	option_editor.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	option_editor.text = fieldinfo.toption_options[option_index]
	option_editor.text_changed.connect(func(text):
		var option_idx = box.get_meta(\"option_idx\")
		fieldinfo.toption_options[option_idx] = text
	)

	var btn_delete = Button.new()
	btn_delete.text = \"DEL\"
	btn_delete.custom_minimum_size = Vector2i(32,32)
	btn_delete.pressed.connect(func():
		var option_idx = box.get_meta(\"option_idx\")
		fieldinfo.toption_options.remove_at(option_idx)
		_init_panel_option()
	)
	box.add_child(option_editor)
	box.add_child(btn_delete)
	option_type_options_list.add_child(box)
"

